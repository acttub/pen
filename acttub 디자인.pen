                            {
                              "type": "text",
                              "id": "tIDb9",
                              "name": "2027학년도부터 소품에 음식물을 쓸 수 없어요. 개인별 고사 일시와 장",
                              "context": "p",
                              "fill": "#8b95a1",
                              "textGrowth": "fixed-width-height",
                              "width": "fill_container",
                              "height": 40,
                              "content": "2027학년도부터 소품에 음식물을 쓸 수 없어요. 개인별 고사 일시와 장소는 2026년 10월 12일 16시부터 홈페이지 수험생정보서비스에서 확인할 수 있어요.",
                              "lineHeight": 1.67,
