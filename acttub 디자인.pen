                                      "fontSize": 14,
                                      "fontWeight": "600"
                                    },
                                    {
                                      "type": "text",
                                      "id": "xvjrD",
                                      "name": "(어떤 기능을 어떤 순서로 사용했는지, 각 단계가 성공했는지 실패했는지,",
                                      "context": "span",
