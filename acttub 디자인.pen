                                      "id": "uQS1r",
                                      "name": "제출서류",
                                      "context": "p",
                                      "fill": "#191f28",
                                      "content": "제출서류",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 12,
                                      "fontWeight": "900"
                                    },
                                    {
                                      "type": "text",
                                      "id": "jM5X4",
                                      "name": "유웨이어플라이·진학어플라이 인터넷 접수만. 수험표는 2026-10-01 ",
                                      "context": "p",
                                      "fill": "#4e5968",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 48.02,
                                      "content": "유웨이어플라이·진학어플라이 인터넷 접수만. 수험표는 2026-10-01 16시부터 출력. 해당자는 추가서류를 2026-10-13 18시 도착분까지 등기우편으로 낸다(10-12 소인까지 유효). 학생부 반영교과는 국어·영어다.",
                                      "lineHeight": 1.85,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 13,
                                      "fontWeight": "600"
                                    }
                                  ]
