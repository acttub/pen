                              "children": [
                                {
                                  "type": "frame",
                                  "id": "SoTXj",
                                  "name": "div",
                                  "context": "div",
                                  "width": "fill_container",
                                  "height": 118.02,
                                  "layout": "vertical",
                                  "gap": 3.99,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "Ju686",
                                      "name": "실기 과제 원문",
                                      "context": "p",
                                      "fill": "#191f28",
                                      "content": "실기 과제 원문",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 12,
                                      "fontWeight": "900"
                                    },
                                    {
                                      "type": "text",
                                      "id": "xXL3q",
                                      "name": "단계별. 1차 2026-10-17 ~ 10-25 중 하루: 자유곡 1곡과",
                                      "context": "p",
                                      "fill": "#4e5968",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 96.04,
                                      "content": "단계별. 1차 2026-10-17 ~ 10-25 중 하루: 자유곡 1곡과 지정곡 1곡을 각 1분 이내로. 자유곡은 한국어 뮤지컬 삽입곡이어야 하고 전주는 두 마디를 넘지 않으며 첫 후렴구를 포함해야 한다. 지정곡 이외의 곡을 골라야 한다. 지정곡은 남녀 각 3곡이고 자기 성별에 맞는 한 곡을 고른다. 지정곡 MR은 고사장에서 제공한다. 1차 발표 10-27 16시. 2차 2026-10-31 ~ 11-01: 연기 워크숍과 개인 구두문답 60분 내외(MR 불가). 최종 발표 2026-11-06 16시.",
                                      "lineHeight": 1.85,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 13,
                                      "fontWeight": "600"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "thFLS",
                                  "name": "div",
                                  "context": "div",
                                  "width": "fill_container",
                                  "height": 94.01,
                                  "layout": "vertical",
                                  "gap": 3.99,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "dzkw3",
                                      "name": "복장",
                                      "context": "p",
                                      "fill": "#191f28",
                                      "content": "복장",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 12,
                                      "fontWeight": "900"
                                    },
                                    {
                                      "type": "text",
                                      "id": "GVd7S",
                                      "name": "실연 음악은 MP3로만 USB에 담아 시험 당일 제출한다(WAV·스마트폰",
                                      "context": "p",
                                      "fill": "#4e5968",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 72.03,
                                      "content": "실연 음악은 MP3로만 USB에 담아 시험 당일 제출한다(WAV·스마트폰·CD 불가). 소품은 입실 전 검사받은 것만 쓸 수 있고 흉기·화기·인화성 물질과 음식물은 금지다. 반주자 등 타인을 데려올 수 없고, 얼굴 전면이 보이도록 머리를 정리해야 하며 써클·컬러렌즈는 착용할 수 없다. 고사장에는 피아노와 큐브(40×40×40cm), 의자가 있다.",
                                      "lineHeight": 1.85,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 13,
                                      "fontWeight": "600"
                                    }
                                  ]
                                },
                                {
                                  "type": "frame",
                                  "id": "WWc6H",
                                  "name": "div",
                                  "context": "div",
                                  "width": "fill_container",
                                  "height": 94.01,
                                  "layout": "vertical",
                                  "gap": 3.99,
                                  "children": [
                                    {
                                      "type": "text",
                                      "id": "k977V",
                                      "name": "준비물",
                                      "context": "p",
                                      "fill": "#191f28",
                                      "content": "준비물",
                                      "lineHeight": 1.5,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 12,
                                      "fontWeight": "900"
                                    },
                                    {
                                      "type": "text",
                                      "id": "hsI10",
                                      "name": "자유곡 MR은 MP3 파일로만 USB에 담아 시험 당일 제출한다(WAV·",
                                      "context": "p",
                                      "fill": "#4e5968",
                                      "textGrowth": "fixed-width-height",
                                      "width": "fill_container",
                                      "height": 72.03,
                                      "content": "자유곡 MR은 MP3 파일로만 USB에 담아 시험 당일 제출한다(WAV·스마트폰·휴대용 플레이어·TAPE·CD 불가). 지정곡 MR은 고사장에서 제공하므로 따로 준비하지 않아도 된다. 소품은 입실 전에 검사받아 허용된 것만 쓸 수 있다. 고사장에 피아노·큐브(40×40×40cm)·의자가 비치되어 있다. 반주자 등 수험생 외 타인은 데려올 수 없다.",
                                      "lineHeight": 1.85,
                                      "fontFamily": "Pretendard Variable",
                                      "fontSize": 13,
                                      "fontWeight": "600"
                                    }
                                  ]
                                },
