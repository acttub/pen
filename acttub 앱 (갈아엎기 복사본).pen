    {
      "type": "frame",
      "id": "n22MC",
      "x": 60000,
      "y": 0,
      "name": "R8 라벨",
      "width": 420,
      "layout": "vertical",
      "gap": 8,
      "children": [
        {
          "type": "text",
          "id": "bR72h",
          "name": "제목",
          "fill": "$text",
          "textGrowth": "fixed-width",
          "width": "fill_container",
